DATABASE_URL=postgresql://USER:PASSWORD@HOST/campus_reserve?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=4000
# Set production only on the hosted server.
NODE_ENV=development
# Server-only walking directions key from openrouteservice.org
ORS_API_KEY=
# Server-only Firebase service-account JSON. Never put this in the Android app.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Public HTTPS backend URL, used when building Android assets.
MOBILE_API_URL=
# Optional additional web origins, comma-separated.
ALLOWED_ORIGINS=
