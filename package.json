{
  "name": "campus-reserve",
  "version": "1.0.0",
  "private": true,
  "description": "College Resource Management System",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/app.js",
    "start": "node server/app.js",
    "db:migrate": "node database/migrate.js",
    "db:setup": "node database/seed.js",
    "db:reset:nitt": "node database/reset-nitt.js",
    "mobile:build": "node scripts/build-mobile.js",
    "mobile:sync": "npm run mobile:build && npx cap sync android",
    "mobile:open": "npx cap open android",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2"
  }
}
